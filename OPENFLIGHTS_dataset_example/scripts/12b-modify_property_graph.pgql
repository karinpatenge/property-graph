----------------------------------------------
--  Modify the OPENFLIGHTS PGQL Property Graph
----------------------------------------------

-- Use SQLcl to connect to your database with your user

-- Turn PGQL mode on
pgql auto on

-- Insert vertices

insert into openflights_graph_pgql
  vertex c
  labels ( city )
  properties (
    c.id = 100000,
    c.city = 'Fantasie',
    c.country = 'DE'
  );

-- Check result:
select
  c.city,
  c.country,
  c.id
from
  match (c is city)
  on openflights_graph_pgql
where
  c.id > 10000;
